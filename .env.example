# Debug Mode
VITE_DEBUG=false

# Gemini API Configuration
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-pro
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI API Configuration
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API Configuration
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet
VITE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama Local LLM Configuration
VITE_OLLAMA_API_KEY=ollama-no-key
VITE_OLLAMA_MODEL=llama3
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1

# Grok (xAI) API Configuration
VITE_GROK_API_KEY=
VITE_GROK_MODEL=grok-3
VITE_GROK_BASE_URL=https://api.x.ai/v1

# Storage Directory Configuration
VITE_STORAGE_DIR=storage

# ── Image Generation ────────────────────────────────────────────────────────
# Image generation API keys are configured in-app via the modal's Advanced panel.
# The VITE_OPENAI_API_KEY above is used as the default for DALL·E image generation.
# For Grok Aurora image generation, the Grok API key (VITE_GROK_API_KEY) is used.
# For Gemini Imagen, the Gemini API key (VITE_GEMINI_API_KEY) is used.
